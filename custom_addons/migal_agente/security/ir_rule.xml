<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="0">
    <record id="migal_agente_estado_cuenta_publicacion_company_rule" model="ir.rule">
        <field name="name">MIGAL Estado de cuenta publicación: compañía</field>
        <field name="model_id" ref="model_migal_agente_estado_cuenta_publicacion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="migal_agente_estado_cuenta_publicacion_system_rule" model="ir.rule">
        <field name="name">MIGAL Estado de cuenta publicación: sistema</field>
        <field name="model_id" ref="model_migal_agente_estado_cuenta_publicacion"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
