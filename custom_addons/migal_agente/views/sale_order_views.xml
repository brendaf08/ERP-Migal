<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_migal_agente" model="ir.ui.view">
        <field name="name">sale.order.form.migal.agente</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_migal_ver_envios" type="object" class="oe_stat_button" icon="fa-whatsapp"
                        invisible="migal_whatsapp_envio_count == 0" groups="sales_team.group_sale_salesman">
                    <field name="migal_whatsapp_envio_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_migal_whatsapp" type="object" string="Abrir en WhatsApp" icon="fa-whatsapp"
                        invisible="state not in ('draft', 'sent')" groups="sales_team.group_sale_salesman"/>
                <button name="action_migal_cobertura" type="object" string="Cobertura preliminar" icon="fa-cubes"
                        invisible="state not in ('draft', 'sent')" groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
