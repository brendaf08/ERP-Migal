<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_abrir_chat_agente" model="ir.actions.server">
        <field name="name">Conversar con el Agente MIGAL</field>
        <field name="model_id" ref="model_migal_agente_log"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_user')])]"/>
        <field name="state">code</field>
        <field name="code">action = env['migal.agente'].action_abrir_chat()</field>
    </record>

    <menuitem id="menu_migal_agente_root" name="Agente MIGAL" sequence="35"
              web_icon="migal_agente,static/description/icon.png"
              groups="base.group_user"/>

    <menuitem id="menu_migal_agente_chat" name="Conversar con el agente" parent="menu_migal_agente_root"
              action="action_server_abrir_chat_agente" sequence="10"/>

    <menuitem id="menu_migal_agente_estado_cuenta" name="Estado de cuenta" parent="menu_migal_agente_root"
              action="action_migal_estado_cuenta_wizard" sequence="20"
              groups="account.group_account_invoice,sales_team.group_sale_manager"/>

    <menuitem id="menu_migal_agente_envios" name="Envíos por WhatsApp" parent="menu_migal_agente_root"
              action="action_migal_whatsapp_envio" sequence="30" groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_migal_agente_config" name="Gobernanza" parent="menu_migal_agente_root" sequence="90"
              groups="sales_team.group_sale_manager,base.group_system"/>

    <menuitem id="menu_migal_agente_log" name="Bitácora (auditoría)" parent="menu_migal_agente_config"
              action="action_migal_agente_log" sequence="10"/>

    <menuitem id="menu_migal_agente_reglas" name="Reglas habituales de cobertura" parent="menu_migal_agente_config"
              action="action_migal_regla_cobertura" sequence="20"/>
</odoo>
