<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="migal_reportes_wizard_estado_cuenta_form" model="ir.ui.view">
        <field name="name">migal.reportes.estado.cuenta.wizard</field>
        <field name="model">migal.agente.estado.cuenta.wizard</field>
        <field name="inherit_id" ref="migal_agente.view_migal_estado_cuenta_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='action_imprimir']" position="replace">
                <button name="action_imprimir_migal_a4" type="object" string="Descargar PDF A4"
                        class="btn-secondary" invisible="not generado"/>
                <button name="action_imprimir_migal_58" type="object" string="Descargar Ticket 58 mm"
                        class="btn-secondary" invisible="not generado"/>
            </xpath>
        </field>
    </record>
</odoo>
