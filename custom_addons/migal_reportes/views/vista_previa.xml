<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_migal_vista_previa" model="ir.ui.view">
        <field name="name">migal.reportes.vista.previa.form</field>
        <field name="model">migal.reportes.vista.previa</field>
        <field name="arch" type="xml">
            <form string="Imprimir">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="accion_a4" invisible="1"/>
                <field name="accion_58" invisible="1"/>
                <field name="tiene_ticket" invisible="1"/>
                <div class="d-flex align-items-center gap-3 mb-2" invisible="not tiene_ticket">
                    <span class="fw-bold">Formato:</span>
                    <field name="formato" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                    <span class="text-muted small" invisible="formato != '58'">Ticket térmico en blanco y negro para impresora de 58 mm.</span>
                </div>
                <field name="vista" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_descargar" type="object" string="Descargar PDF" class="btn-primary" icon="fa-download"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
