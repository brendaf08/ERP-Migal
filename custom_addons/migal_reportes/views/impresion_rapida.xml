<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_migal_venta_formatos" model="ir.ui.view">
        <field name="name">migal.sale.order.print.formats</field>
        <field name="priority" eval="99"/>
        <field name="model">migal.reportes.imprimir.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir">
                <field name="documento_id" invisible="1"/>
                <field name="sale_order_id" invisible="1"/>
                <footer>
                    <button name="action_imprimir_venta_a4" type="object" string="PDF A4" class="btn-primary"/>
                    <button name="action_imprimir_venta_58" type="object" string="Ticket 58 mm" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acciones a un clic, accesibles desde los formularios de trabajo. -->
    <record id="view_migal_venta_rapida" model="ir.ui.view">
        <field name="name">migal.sale.order.quick.print</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[@id='quotation_send_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@id='quotation_send']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@id='send_proforma']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@name='sale.action_report_saleorder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form/header" position="inside">
                <button string="Guardar" special="save" class="btn-primary"
                        invisible="state not in ('draft', 'sent') or locked"/>
                <button name="action_migal_imprimir" type="object" string="Imprimir"
                        class="btn-secondary" invisible="not id"/>
                <details class="o_migal_ventas_mensajes o_migal_toggle_chatter">
                    <summary title="Mensajes y actividad">
                        <i class="fa fa-comments-o" aria-hidden="true"/>
                        <span class="visually-hidden">Mensajes y actividad</span>
                    </summary>
                </details>
            </xpath>
            <xpath expr="//form/sheet/notebook" position="attributes">
                <attribute name="class" add="o_migal_encabezado_pestanas" separator=" "/>
            </xpath>
            <xpath expr="//form/sheet/notebook" position="before">
                <div name="migal_venta_encabezado" class="o_migal_encabezado"/>
            </xpath>
            <xpath expr="//sheet/div[@name='migal_venta_encabezado']" position="inside">
                <xpath expr="//form/sheet/div[hasclass('oe_title')]" position="move"/>
                <xpath expr="//form/sheet/group[@name='sale_header']" position="move"/>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']/button[@name='action_view_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_migal_factura_rapida" model="ir.ui.view">
        <field name="name">migal.account.move.quick.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_migal_descargar_a4" type="object" string="MIGAL · Vista A4" class="btn-secondary" icon="fa-file-pdf-o"
                        invisible="move_type not in ('out_invoice','out_refund','out_receipt') or state != 'posted'"/>
                <button name="action_migal_descargar_58" type="object" string="MIGAL · Vista 58 mm" class="btn-secondary" icon="fa-print"
                        invisible="move_type not in ('out_invoice','out_refund','out_receipt') or state != 'posted'"/>
            </xpath>
        </field>
    </record>
    <record id="view_migal_entrega_rapida" model="ir.ui.view">
        <field name="name">migal.stock.picking.quick.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_migal_descargar_a4" type="object" string="MIGAL · PDF A4" class="btn-secondary" icon="fa-file-pdf-o"/>
                <button name="action_migal_descargar_58" type="object" string="MIGAL · Ticket 58 mm" class="btn-secondary" icon="fa-print"/>
            </xpath>
        </field>
    </record>
    <record id="view_migal_pago_rapido" model="ir.ui.view">
        <field name="name">migal.account.payment.quick.print</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_migal_descargar_a4" type="object" string="MIGAL · PDF A4" class="btn-secondary" icon="fa-file-pdf-o"/>
                <button name="action_migal_descargar_58" type="object" string="MIGAL · Ticket 58 mm" class="btn-secondary" icon="fa-print"/>
            </xpath>
        </field>
    </record>
    <record id="view_migal_cliente_rapido" model="ir.ui.view">
        <field name="name">migal.res.partner.quick.print</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_accounting_kit.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='customer_statement_page']/button[@name='action_print_pdf']" position="replace">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button name="action_migal_estado_a4" type="object" string="PDF A4"
                            class="btn-primary" icon="fa-file-pdf-o"
                            groups="account.group_account_invoice,sales_team.group_sale_manager"/>
                    <button name="action_migal_estado_58" type="object" string="Ticket 58 mm"
                            class="btn-secondary" icon="fa-print"
                            groups="account.group_account_invoice,sales_team.group_sale_manager"/>
                    <button name="action_migal_contacto_whatsapp" type="object" string="WhatsApp"
                            class="btn-secondary" icon="fa-whatsapp" invisible="not phone"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='customer_statement_page']/button[@name='action_print_xlsx']" position="replace"/>
            <xpath expr="//page[@name='customer_statement_page']/button[@name='action_share_pdf']" position="replace"/>
            <xpath expr="//page[@name='customer_statement_page']/button[@name='action_share_xlsx']" position="replace"/>
            <xpath expr="//page[@name='customer_statement_page']/br[1]" position="replace"/>
            <xpath expr="//page[@name='customer_statement_page']/br[1]" position="replace"/>
            <xpath expr="//page[@name='supplier_statement']/button[@name='action_vendor_print_pdf']" position="replace">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button name="action_vendor_print_pdf" type="object" string="PDF A4"
                            class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_migal_contacto_whatsapp" type="object" string="WhatsApp"
                            class="btn-secondary" icon="fa-whatsapp" invisible="not phone"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='supplier_statement']/button[@name='action_vendor_print_xlsx']" position="replace"/>
            <xpath expr="//page[@name='supplier_statement']/button[@name='action_vendor_share_pdf']" position="replace"/>
            <xpath expr="//page[@name='supplier_statement']/button[@name='action_vendor_share_xlsx']" position="replace"/>
            <xpath expr="//page[@name='supplier_statement']/br[1]" position="replace"/>
            <xpath expr="//page[@name='supplier_statement']/br[1]" position="replace"/>
        </field>
    </record>
</odoo>
