<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_migal_encabezado_factura" model="ir.ui.view">
        <field name="name">account.move.migal.header.factura</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="before">
                <div class="o_migal_encabezado"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]" position="inside">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]/following-sibling::group[1]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]/group" position="before">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/notebook" position="attributes">
                <attribute name="class" add="o_migal_encabezado_pestanas" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="view_migal_encabezado_despacho" model="ir.ui.view">
        <field name="name">stock.picking.migal.header.despacho</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="before">
                <div class="o_migal_encabezado"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]" position="inside">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]/following-sibling::group[1]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]/group" position="before">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/notebook" position="attributes">
                <attribute name="class" add="o_migal_encabezado_pestanas" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="view_migal_encabezado_pago" model="ir.ui.view">
        <field name="name">account.payment.migal.header.pago</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="before">
                <div class="o_migal_encabezado"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]" position="inside">
                <xpath expr="/form/sheet/group[@name='main_group']" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]/group" position="before">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/group/notebook[@name='payment_notebook']" position="attributes">
                <attribute name="class" add="o_migal_encabezado_pestanas" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="view_migal_encabezado_solicitud" model="ir.ui.view">
        <field name="name">sale.order.request.migal.header.solicitud</field>
        <field name="model">sale.order.request</field>
        <field name="inherit_id" ref="migal_reportes.view_migal_solicitud_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="before">
                <div class="o_migal_encabezado"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]" position="inside">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]/following-sibling::group[1]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]/group" position="before">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="move"/>
                <xpath expr="/form/sheet/field[@name='state'][@widget='badge']" position="move"/>
            </xpath>
        </field>
    </record>

    <record id="view_migal_encabezado_historial_solicitud" model="ir.ui.view">
        <field name="name">sale.order.request.migal.header.historial_solicitud</field>
        <field name="model">sale.order.request</field>
        <field name="inherit_id" ref="sale_order_request.view_sale_order_request_history_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="before">
                <div class="o_migal_encabezado"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]" position="inside">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]/following-sibling::group[1]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/div[hasclass('o_migal_encabezado')]/group" position="before">
                <xpath expr="/form/sheet/div[hasclass('oe_title')]" position="move"/>
            </xpath>
            <xpath expr="/form/sheet/notebook" position="attributes">
                <attribute name="class" add="o_migal_encabezado_pestanas" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
