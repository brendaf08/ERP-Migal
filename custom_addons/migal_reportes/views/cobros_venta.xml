<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_migal_venta_cobro_wizard" model="ir.ui.view">
        <field name="name">migal.venta.cobro.wizard.form</field>
        <field name="model">migal.venta.cobro.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar cobro">
                <group>
                    <field name="order_id" invisible="1" force_save="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="valid_method_ids" invisible="1"/>
                    <field name="amount"/>
                    <field name="date"/>
                    <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="payment_method_line_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="reference" placeholder="Operación, transferencia o referencia"/>
                </group>
                <footer>
                    <button name="action_registrar" type="object" string="Contabilizar cobro" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_migal_venta_comprobante_wizard" model="ir.ui.view">
        <field name="name">migal.venta.comprobante.wizard.form</field>
        <field name="model">migal.venta.comprobante.wizard</field>
        <field name="arch" type="xml">
            <form string="Emisión en Key Fácil">
                <group>
                    <field name="order_id" invisible="1" force_save="1"/>
                    <field name="status"/>
                    <field name="code" required="status in ('invoice', 'receipt')"
                           invisible="status not in ('invoice', 'receipt')" placeholder="Ej. F001-000123"/>
                </group>
                <footer>
                    <button name="action_registrar" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_migal_confirmar_solicitud_wizard" model="ir.ui.view">
        <field name="name">migal.venta.confirmar.solicitud.wizard.form</field>
        <field name="model">migal.venta.confirmar.solicitud.wizard</field>
        <field name="arch" type="xml">
            <form string="Aceptar y confirmar">
                <group>
                    <field name="request_id" invisible="1" force_save="1"/>
                    <field name="tipo_emision" widget="radio"/>
                </group>
                <footer>
                    <button name="action_confirmar" type="object" string="Confirmar orden de venta" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_migal_venta_resumen_cobros" model="ir.ui.view">
        <field name="name">migal.venta.resumen.cobros</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="95"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='migal_venta_encabezado']/div[hasclass('oe_title')]/h1" position="attributes">
                <attribute name="class" add="d-flex flex-wrap align-items-center gap-2" separator=" "/>
            </xpath>
            <xpath expr="//div[@name='migal_venta_encabezado']/div[hasclass('oe_title')]/h1" position="inside">
                <field name="migal_estado_cobro" widget="badge" readonly="1" nolabel="1"
                       class="fs-6 flex-shrink-0 m-0"
                       invisible="state != 'sale'"
                       decoration-success="migal_estado_cobro == 'paid'"
                       decoration-warning="migal_estado_cobro == 'partial'"
                       decoration-danger="migal_estado_cobro == 'pending'"/>
            </xpath>
            <xpath expr="//header//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form/sheet" position="after">
                <aside class="o_migal_venta_resumen" aria-label="Resumen de la venta">
                    <div class="o_migal_venta_resumen_tarjeta">
                        <h2 class="h5 mb-3">Resumen de la venta</h2>
                        <div class="o_migal_venta_resumen_fila">
                            <strong>Cotización</strong>
                            <field name="migal_resumen_cotizacion_id" readonly="1" nolabel="1" invisible="not id"/>
                            <span class="text-muted" invisible="id">Nueva</span>
                        </div>
                        <div class="o_migal_venta_resumen_fila">
                            <strong>Solicitud</strong>
                            <field name="migal_solicitud_id" readonly="1" nolabel="1" invisible="not migal_solicitud_id"/>
                            <span class="text-muted" invisible="migal_solicitud_id">Por crear</span>
                        </div>
                        <div class="o_migal_venta_resumen_fila" invisible="not migal_solicitud_id">
                            <strong>Estado de solicitud</strong>
                            <field name="migal_resumen_estado_solicitud" widget="badge" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_migal_venta_resumen_fila">
                            <strong>Orden de venta</strong>
                            <field name="migal_resumen_orden_id" readonly="1" nolabel="1" invisible="not migal_resumen_orden_id"/>
                            <span class="text-muted" invisible="migal_resumen_orden_id">Por confirmar</span>
                        </div>
                        <div class="o_migal_venta_resumen_fila">
                            <strong>Etapa actual</strong>
                            <field name="state" widget="badge" readonly="1" nolabel="1"
                                   decoration-success="state == 'sale'" decoration-muted="state == 'cancel'"/>
                        </div>
                        <section class="o_migal_venta_resumen_seccion" invisible="not migal_resumen_orden_id"
                                 groups="sales_team.group_sale_salesman,stock.group_stock_user">
                            <h3 class="h6">Despachos</h3>
                            <field name="migal_resumen_despacho_ids" readonly="1" nolabel="1" invisible="not migal_resumen_despacho_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="name" string="Referencia"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
                                </list>
                            </field>
                            <span class="text-muted" invisible="migal_resumen_despacho_ids">Sin despachos asociados</span>
                        </section>
                        <section class="o_migal_venta_resumen_seccion" invisible="not partner_id">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                <h3 class="h6 mb-0">Pagos</h3>
                                <button name="action_migal_ver_cobros" type="object" string="Pagos del cliente"
                                        class="btn btn-outline-secondary btn-sm"
                                        groups="account.group_account_invoice" invisible="not id"/>
                            </div>
                            <div class="o_migal_venta_resumen_fila" invisible="state != 'sale'">
                                <strong>Cobrado en esta orden</strong>
                                <field name="migal_cobrado" readonly="1" nolabel="1"/>
                            </div>
                            <div class="o_migal_venta_resumen_fila" invisible="state != 'sale'">
                                <strong>Saldo pendiente</strong>
                                <field name="migal_saldo_cobro" readonly="1" nolabel="1"/>
                            </div>
                            <button name="action_migal_registrar_cobro" type="object" string="Registrar cobro"
                                    class="btn btn-primary btn-sm mt-2"
                                    groups="account.group_account_invoice"
                                    invisible="state != 'sale' or not migal_saldo_cobro"/>
                        </section>
                        <section class="o_migal_venta_resumen_seccion" invisible="state != 'sale'">
                            <h3 class="h6">Emisión en Key Fácil</h3>
                            <div class="o_migal_venta_resumen_fila">
                                <strong>Estado de emisión</strong>
                                <field name="migal_comprobante_externo" widget="badge" readonly="1" nolabel="1"
                                       decoration-warning="migal_comprobante_externo in ('receipt_pending', 'invoice_pending')"/>
                            </div>
                            <div class="o_migal_venta_resumen_fila" invisible="not migal_codigo_comprobante">
                                <strong>Referencia de Key Fácil</strong>
                                <field name="migal_codigo_comprobante" readonly="1" nolabel="1"/>
                            </div>
                            <button name="action_migal_registrar_comprobante" type="object"
                                    string="Actualizar emisión" class="btn btn-outline-secondary btn-sm mt-2"
                                    groups="sales_team.group_sale_salesman,account.group_account_invoice"/>
                        </section>
                    </div>
                </aside>
            </xpath>
        </field>
    </record>
    <record id="view_migal_cobro_orden_pago" model="ir.ui.view">
        <field name="name">migal.cobro.orden.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[@name='main_group']" position="after">
                <group invisible="not migal_orden_cobro_id">
                    <field name="migal_orden_cobro_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
