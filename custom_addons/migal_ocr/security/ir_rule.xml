<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="0">
    <record id="migal_ocr_documento_company_rule" model="ir.rule">
        <field name="name">MIGAL OCR documento: compañía</field>
        <field name="model_id" ref="model_migal_ocr_documento"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="migal_ocr_documento_system_rule" model="ir.rule">
        <field name="name">MIGAL OCR documento: sistema</field>
        <field name="model_id" ref="model_migal_ocr_documento"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="migal_ocr_linea_company_rule" model="ir.rule">
        <field name="name">MIGAL OCR línea: compañía del documento</field>
        <field name="model_id" ref="model_migal_ocr_linea"/>
        <field name="domain_force">[('documento_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="migal_ocr_linea_system_rule" model="ir.rule">
        <field name="name">MIGAL OCR línea: sistema</field>
        <field name="model_id" ref="model_migal_ocr_linea"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
