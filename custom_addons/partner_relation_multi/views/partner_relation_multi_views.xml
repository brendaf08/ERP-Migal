<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sección "Contactos Asociados" con el mismo comportamiento que la
         sección estándar "Contactos" del formulario de contacto: tarjetas
         kanban, alta y edición inline y selección de registros existentes. -->
    <record id="view_partner_form_relation_multi_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.relation.multi.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contactos Asociados" name="related_contacts">
                    <field name="related_contact_ids"
                           mode="kanban"
                           domain="[('id', '!=', id)]"
                           add-label="Añadir contacto o empresa"
                           context="{'default_type': 'contact'}">
                        <kanban color="color">
                            <field name="color"/>
                            <field name="type"/>
                            <field name="is_company"/>
                            <templates>
                                <t t-name="card" class="flex-row">
                                    <aside class="o_kanban_aside_full">
                                        <field name="avatar_128"
                                               class="o_kanban_image_fill w-100"
                                               widget="image"
                                               options="{'img_class': 'object-fit-cover'}"
                                               alt="Imagen del contacto"
                                               invisible="type != 'contact'"/>
                                        <field name="avatar_128"
                                               class="o_kanban_image_fill w-100"
                                               widget="image"
                                               options="{'img_class': 'object-fit-contain p-2'}"
                                               alt="Imagen del contacto"
                                               invisible="type == 'contact'"/>
                                    </aside>
                                    <main class="ps-2 ps-md-0">
                                        <field name="name" invisible="not name" class="fw-bold"/>
                                        <field name="type" invisible="name" class="fw-bold"/>
                                        <div t-if="record.email.raw_value" class="text-truncate">
                                            <i class="fa fa-fw me-1 fa-envelope text-primary" title="Correo electrónico"/>
                                            <field name="email"/>
                                        </div>
                                        <div t-if="record.phone.raw_value">
                                            <i class="fa fa-fw me-1 fa-phone text-primary" title="Teléfono"/>
                                            <field name="phone"/>
                                        </div>
                                        <div invisible="not function or is_company">
                                            <i class="fa fa-fw me-1 fa-suitcase text-primary" title="Puesto"/>
                                            <field name="function"/>
                                        </div>
                                        <div t-if="record.type.raw_value != 'contact' and (record.city.raw_value or record.country_id.raw_value)">
                                            <i class="fa fa-fw me-1 fa-map-marker text-primary" title="Ubicación"/>
                                            <field name="city"/>
                                            <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>
                                            <field name="country_id"/>
                                        </div>
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Contacto Asociado">
                            <sheet>
                                <field name="image_1920"
                                       widget="image"
                                       class="oe_avatar"
                                       options="{'preview_image': 'avatar_128'}"/>
                                <div class="oe_title">
                                    <field name="company_type"
                                           widget="radio"
                                           options="{'horizontal': true}"/>
                                    <h1>
                                        <field name="name"
                                               default_focus="1"
                                               placeholder="Nombre del contacto o empresa"
                                               required="1"/>
                                    </h1>
                                </div>
                                <group>
                                    <group string="Contacto">
                                        <field name="email" widget="email" placeholder="Correo electrónico"/>
                                        <field name="phone" widget="phone" placeholder="Teléfono"/>
                                        <field name="function" placeholder="Puesto de trabajo" invisible="is_company"/>
                                    </group>
                                    <group string="Dirección">
                                        <field name="street" placeholder="Calle..."/>
                                        <field name="street2" placeholder="Calle 2..."/>
                                        <field name="city" placeholder="Ciudad"/>
                                        <field name="state_id" placeholder="Provincia / Estado" options="{'no_open': True}"/>
                                        <field name="zip" placeholder="Código postal"/>
                                        <field name="country_id" placeholder="País" options="{'no_open': True, 'no_create': True}"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                    <div class="text-muted mt-2">
                        La relación es bidireccional: el contacto asociado también
                        mostrará esta ficha en su sección «Contactos Asociados».
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
