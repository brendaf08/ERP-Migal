<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Definición de aprobación: Abastecimiento -->
        <!-- Se aplica cuando el stock es insuficiente -->
        <record id="tier_def_sale_order_request_supply" model="tier.definition">
            <field name="name">Aprobación de abastecimiento</field>
            <field name="model_id" ref="sale_order_request.model_sale_order_request"/>
            <field name="definition_domain">[('stock_sufficient', '=', False)]</field>
            <field name="reviewer_group_id" ref="sale_order_request.group_sale_order_request_supply"/>
            <field name="review_type">group</field>
            <field name="sequence">10</field>
            <field name="approve_sequence">False</field>
            <field name="company_id" eval="False"/>
            <field name="exclude_requester">True</field>
        </record>

        <!-- Definición de aprobación: Transporte -->
        <!-- Se aplica cuando la modalidad es despacho -->
        <record id="tier_def_sale_order_request_transport" model="tier.definition">
            <field name="name">Aprobación de transporte</field>
            <field name="model_id" ref="sale_order_request.model_sale_order_request"/>
            <field name="definition_domain">[('delivery_mode', '=', 'delivery')]</field>
            <field name="reviewer_group_id" ref="sale_order_request.group_sale_order_request_transport"/>
            <field name="review_type">group</field>
            <field name="sequence">20</field>
            <field name="approve_sequence">False</field>
            <field name="company_id" eval="False"/>
            <field name="exclude_requester">True</field>
        </record>
    </data>
</odoo>
