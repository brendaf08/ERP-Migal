@startuml c4-componentes-compras
' Vista C4 de nivel 3: componentes de la aplicación Compras.
' Muestra el módulo de Compras, su dependencia de Facturación y el módulo de enlace que lo vincula con Inventario.
' Definiciones de elementos: c4-estilos-y-leyenda.iuml.

!include <C4/C4_Component>
!include ../c4-estilos-y-leyenda.iuml

LAYOUT_TOP_DOWN()

title Ferre & Inversiones MIGAL - Componentes de Compras
leyenda_colores()

Container_Boundary(compras, "Compras") {
  comp_compras()
}

app_facturacion()
puente_purchase_stock()
puente_stock_account()

Rel(comprasMod, facturacion, "depende de", $tags="dependencia")

Rel(purchaseStock, comprasMod, "auto_install", $tags="dependencia")
Rel(purchaseStock, stockAccount, "auto_install", $tags="dependencia")
@enduml
