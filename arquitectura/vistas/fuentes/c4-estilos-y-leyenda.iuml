' --- Módulos de enlace instalados automáticamente (auto_install) ---
!procedure puente_stock_account()
Container(stockAccount, "Valoración de inventario", "stock_account", "Enlaza movimientos de inventario con asientos contables.", $tags="puente")
!endprocedure

!procedure puente_sale_stock()
Container(saleStock, "Ventas e Inventario", "sale_stock", "Enlaza pedidos de venta con entregas.", $tags="puente")
!endprocedure

!procedure puente_purchase_stock()
Container(purchaseStock, "Compras e Inventario", "purchase_stock", "Enlaza órdenes de compra con recepciones.", $tags="puente")
!endprocedure

!procedure puente_pos_sale()
Container(posSale, "Punto de Venta y Ventas", "pos_sale", "Enlaza el punto de venta con pedidos de venta.", $tags="puente")
!endprocedure

!procedure puente_sale_crm()
Container(saleCrm, "Ventas y CRM", "sale_crm", "Enlaza oportunidades con cotizaciones.", $tags="puente")
!endprocedure

' --- Bibliotecas OCA requeridas por los complementos ---
!procedure oca_date_range()
Container(dateRange, "Rangos de fechas", "date_range", "Periodos reutilizables para reportes.", $tags="oca")
!endprocedure

!procedure oca_report_xlsx()
Container(reportXlsx, "Exportación a Excel", "report_xlsx", "Motor de reportes en formato XLSX.", $tags="oca")
!endprocedure

' --- Componentes de Facturación ---
!procedure comp_account()
Component(account, "Núcleo contable", "account", "Facturas, pagos, asientos y conciliación.", $tags="seleccionada")
!endprocedure

!procedure comp_account_financial_report()
Component(accountFinancialReport, "Reportes contables", "account_financial_report", "Libro mayor, balance de comprobación y reportes asociados.", $tags="oca")
!endprocedure

!procedure comp_mis_builder()
Component(misBuilder, "Constructor de reportes", "mis_builder", "Reportes e indicadores definidos mediante plantillas.", $tags="oca")
!endprocedure

!procedure comp_mis_template()
Component(misTemplate, "Plantillas financieras", "mis_template_financial_report", "Balance general y estado de resultados. Disponibilidad en 19.0 por verificar.", $tags="oca")
!endprocedure
